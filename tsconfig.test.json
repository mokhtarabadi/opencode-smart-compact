{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": false,
    "declaration": false,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": ["src", "tests"]
}
